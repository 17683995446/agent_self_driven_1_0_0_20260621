# ===== 项目运行时产物 =====
# 日志文件（保留目录占位）
logs/*
!logs/.gitkeep

# 测试快照（保留目录占位）
test_snapshots/*
!test_snapshots/.gitkeep

# 运行时数据（PID文件等，保留目录占位）
data/*
!data/.gitkeep

